# Copy to .env and fill in. Never commit .env.

# Master key used to derive each synthetic employee's TOTP secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOTP_MASTER_KEY=

# Shared secret the ElevenLabs webhook tools send in the X-Tool-Secret header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SHARED_SECRET=

# ElevenLabs API key (used by the test runner and config sync scripts).
ELEVENLABS_API_KEY=

# Optional, for employees whose factor is okta_push (Stretch 1).
# Okta org URL and the client ID of an API Services app that signs in with
# private_key_jwt + DPoP (see README). The private key file stays out of git.
OKTA_ORG_URL=
OKTA_CLIENT_ID=
# OKTA_PRIVATE_KEY_PATH=.secrets/okta_service_app.pem
